APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Dipakai untuk URL foto. Untuk tes dari HP, isi dengan IP LAN laptop, misalnya http://192.168.1.5:8000
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_waste
DB_USERNAME=root
DB_PASSWORD=
# Hanya untuk database yang mewajibkan SSL (Aiven di production): path file CA, misalnya /etc/secrets/ca.pem
MYSQL_ATTR_SSL_CA=

ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT=10
# Harus sama dengan ML_SERVICE_TOKEN di servis FastAPI. Kosong = tidak dikirim (lokal).
ML_SERVICE_TOKEN=

# Disk foto laporan: public (storage/app/public, lokal) atau cloudinary (production).
PHOTO_DISK=public
# Wajib jika PHOTO_DISK=cloudinary. Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
