# Alamat REST API Laravel, diakhiri /api.
# Server demo (Vercel):
EXPO_PUBLIC_API_URL=https://smart-waste-web1.vercel.app/api
# Untuk server lokal lewat Expo Go, pakai IP LAN laptop (lihat dengan `ipconfig`), bukan 127.0.0.1, misalnya:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:8000/api
# Build APK (EAS) tidak membaca file ini; URL-nya diatur di eas.json, profil preview.
