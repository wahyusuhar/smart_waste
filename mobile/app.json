{
  "expo": {
    "name": "Smart Waste",
    "slug": "smart-waste",
    "scheme": "smartwaste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wahyu.smartwaste",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Smart Waste memakai kamera untuk memotret tumpukan sampah yang Anda laporkan.",
          "photosPermission": "Smart Waste membuka galeri agar Anda bisa memilih foto tumpukan sampah.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Smart Waste membaca lokasi Anda agar petugas tahu di mana tumpukan sampah berada."
        }
      ]
    ]
  }
}
