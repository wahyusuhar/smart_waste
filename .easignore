/web/
/ml/
/docs/

# From mobile/.gitignore
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/expo-env.d.ts
mobile/android/
mobile/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.env*.local
